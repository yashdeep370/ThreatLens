# Copy this file to .env and fill in ONE (or both) keys. Never commit .env.

# Option A: Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Option B: Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Option C: a single key - provider is auto-detected (AIza... = Gemini, gsk_... = Groq)
# LLM_API_KEY=

# Optional: which provider to try first when both keys are set (gemini | groq)
# LLM_PROVIDER=gemini

# Optional: override models
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
